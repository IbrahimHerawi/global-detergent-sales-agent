# Application
APP_NAME=Global Detergent Factory AI Sales Agent
APP_ENV=development
DEMO_DATA_MODE=false

# OpenAI (replace placeholders; never commit real credentials)
AI_ENABLED=false
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL=<model-available-to-your-openai-project>
OPENAI_TIMEOUT_SECONDS=45
MAX_TOOL_ITERATIONS=8

# Meta WhatsApp Cloud API (replace placeholders; never commit real credentials)
WHATSAPP_ACCESS_TOKEN=<whatsapp-access-token>
WHATSAPP_PHONE_NUMBER_ID=<whatsapp-phone-number-id>
WHATSAPP_VERIFY_TOKEN=<webhook-verify-token>
META_APP_SECRET=<meta-app-secret>
META_GRAPH_API_VERSION=v23.0
WHATSAPP_TIMEOUT_SECONDS=20

# Redis and bounded operational state
REDIS_URL=redis://redis:6379/0
SESSION_TTL_SECONDS=86400
MESSAGE_DEDUP_TTL_SECONDS=604800
RECENT_MESSAGE_LIMIT=20

# Container paths
COMPANY_DATA_PATH=/app/app/data/company.json
PRODUCT_DATA_PATH=/app/app/data/products.json
QUOTE_RULES_PATH=/app/app/data/quotation_rules.json
QUOTE_STORAGE_PATH=/app/storage/quotes

# Inbound request limits
MAX_INBOUND_TEXT_LENGTH=4096
MAX_WEBHOOK_BODY_SIZE=1048576
