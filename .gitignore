# Secrets and local environment configuration
.env
.env.*
!.env.example
*.pem
*.key

# Python virtual environments
.venv/
venv/
env/

# Python caches and build output
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Test, type-checker, linter, and coverage caches
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Generated quotation artifacts
storage/quotes/*
!storage/quotes/.gitkeep
*.pdf

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local logs and temporary files
*.log
*.tmp
tmp/
